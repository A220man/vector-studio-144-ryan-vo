# Application
APP_NAME=vector-studio
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Security
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC / Keycloak
OIDC_ISSUER_URL=http://localhost:8081/realms/vector-studio
OIDC_CLIENT_ID=vector-studio-frontend
OIDC_CLIENT_SECRET=dev-secret-change-in-production
OIDC_REDIRECT_URI=http://localhost:5173/callback

# LLM (optional)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]